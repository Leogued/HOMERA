{
  "name": "homera",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/check-deps.mjs && next dev",
    "build": "node scripts/check-deps.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "images": "node scripts/build-images.mjs",
    "test": "node scripts/test-motion.mjs && npm run test:backend",
    "quality:gate": "node scripts/quality-gate.mjs",
    "audit:home": "node scripts/audit-home.mjs",
    "test:backend": "node --experimental-strip-types --no-warnings --import ./scripts/ts-alias-register.mjs scripts/test-backend.mts",
    "db:reset": "node --experimental-strip-types --no-warnings --import ./scripts/ts-alias-register.mjs scripts/db-reset.mts",
    "test:scenarios": "node scripts/test-scenarios.mjs",
    "test:search": "node --experimental-strip-types --no-warnings --import ./scripts/ts-alias-register.mjs scripts/test-search-redirect.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
