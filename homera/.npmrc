# HOMERA — pas de script d’installation des dépendances.
#
# Pourquoi : better-sqlite3 v13 embarque déjà ses binaires précompilés
# (dossier prebuilds/, toutes plateformes) et ne déclare AUCUN script
# d’installation. Mais npm, voyant le fichier binding.gyp, remplace le
# script absent par « node-gyp rebuild » : il télécharge les en-têtes
# Node et recompile SQLite en C++ pendant plusieurs minutes — et échoue
# sur toute machine sans Python ni chaîne de compilation (le cas typique
# d’un poste Windows avec VS Code). L’installation avorte alors, ou
# l’utilisateur l’interrompt, et « npm run dev » échoue ensuite sur
# « Module not found: Can't resolve 'better-sqlite3' ».
#
# Aucune autre dépendance du projet n’a besoin de ses scripts
# (SWC, Oxide et LightningCSS sont des binaires précompilés), donc les
# ignorer ne retire rien — vérifié par une installation depuis zéro.
#
# ATTENTION si vous ajoutez une dépendance qui compile ou télécharge son
# binaire dans un script d’installation (ex. sharp) : ce réglage le
# neutraliserait. Réévaluez-le à ce moment-là.
ignore-scripts=true
